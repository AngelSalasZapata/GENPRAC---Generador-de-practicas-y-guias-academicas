<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeneradorEjerciciosAvalonia.ViewModels"
        xmlns:views="using:GeneradorEjerciciosAvalonia.Views"
        x:Class="GeneradorEjerciciosAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="750" MinWidth="900" MinHeight="600"
        Icon="/Assets/app.ico"
        Title="Generador de Ejercicios PDF">
    <Grid ColumnDefinitions="225,*">
        <Grid Grid.Column="0" Background="#0e6296" RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Margin="0,30,0,24" Spacing="4">
                <TextBlock Text="📝 Generador" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Ejercicios PDF" Foreground="#b4e3fa" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="10" Margin="15,0">
                <Button Classes="action-button" Content="🎲  Generar PDF" Height="45" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="16,0"
                        Background="{Binding FondoGenerar}" Foreground="White"
                        Command="{Binding NavegarCommand}" CommandParameter="generar"/>
                <Button Classes="action-button" Content="📚  Banco de Ejercicios" Height="45" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="16,0"
                        Background="{Binding FondoBanco}" Foreground="White"
                        Command="{Binding NavegarCommand}" CommandParameter="banco"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="© Angel Fabiano Salas Zapata" Foreground="#8ec2df"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        </Grid>

        <Grid Grid.Column="1" Background="#eef7fc">
            <views:GenerarView DataContext="{Binding Generar}"/>
            <views:BancoView DataContext="{Binding Banco}"/>
        </Grid>
    </Grid>
</Window>
