<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeneradorEjerciciosAvalonia.ViewModels"
             x:Class="GeneradorEjerciciosAvalonia.Views.EstadisticasView"
             x:DataType="vm:EstadisticasViewModel"
             IsVisible="{Binding EsVisible}">
    <ScrollViewer>
        <StackPanel Margin="25">
            <TextBlock Text="📊 Estadísticas del Banco" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Resumen del estado actual de su banco de ejercicios"
                       FontSize="13" Foreground="#7f8c8d" Margin="0,4,0,16"/>

            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="8" Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Total" Foreground="#7f8c8d" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Total}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="8" Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Básicos" Foreground="#7f8c8d" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Basicos}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EstadoBasico}" FontSize="11"
                                   Foreground="{Binding ColorBasico}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="8" Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Intermedios" Foreground="#7f8c8d" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Intermedios}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EstadoIntermedio}" FontSize="11"
                                   Foreground="{Binding ColorIntermedio}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" CornerRadius="12" Margin="8" Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Difíciles" Foreground="#7f8c8d" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dificiles}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EstadoDificil}" FontSize="11"
                                   Foreground="{Binding ColorDificil}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="12" Margin="8,10,8,25" Padding="35,28">
                <StackPanel Spacing="14">
                    <TextBlock Text="Distribución por Dificultad" FontSize="17" FontWeight="Bold"/>

                    <Grid ColumnDefinitions="150,Auto" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="Básico" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Height="24" RadiusX="5" RadiusY="5"
                                   Fill="{Binding ColorBasico}" Width="{Binding AnchoBasico}"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto">
                        <TextBlock Grid.Column="0" Text="Intermedio" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Height="24" RadiusX="5" RadiusY="5"
                                   Fill="{Binding ColorIntermedio}" Width="{Binding AnchoIntermedio}"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto">
                        <TextBlock Grid.Column="0" Text="Difícil" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Height="24" RadiusX="5" RadiusY="5"
                                   Fill="{Binding ColorDificil}" Width="{Binding AnchoDificil}"
                                   HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Text="{Binding ObjetivoTexto}" FontSize="12" Foreground="#7f8c8d"/>
                    <TextBlock Text="⚠️ El banco aún no cubre la distribución ideal."
                               FontSize="12" Foreground="#e74c3c"
                               IsVisible="{Binding !EstaCompleto}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
