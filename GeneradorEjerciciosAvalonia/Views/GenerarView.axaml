<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeneradorEjerciciosAvalonia.ViewModels"
             x:Class="GeneradorEjerciciosAvalonia.Views.GenerarView"
             x:DataType="vm:GenerarViewModel"
             IsVisible="{Binding EsVisible}">
    <Grid ColumnDefinitions="420,*" ColumnSpacing="18" Margin="22,18">
        <ScrollViewer Grid.Column="0">
        <StackPanel HorizontalAlignment="Center" MaxWidth="400">
            <Border Background="White" CornerRadius="12" Padding="0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Configuración de Ejercicios" FontSize="17" FontWeight="Bold"
                               Margin="35,28,35,18"/>

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="35,0">
                        <TextBlock Grid.Column="0" Text="Básicos" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="70" Text="{Binding Basicos}"
                                 HorizontalContentAlignment="Center"/>
                        <StackPanel Grid.Column="2" Spacing="2" Margin="6,0,0,0">
                            <Button Content="▲" Width="34" Height="24" Padding="0"
                                    Command="{Binding IncrementarBasicosCommand}"/>
                            <Button Content="▼" Width="34" Height="24" Padding="0"
                                    Command="{Binding DecrementarBasicosCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="35,8,35,0">
                        <TextBlock Grid.Column="0" Text="Intermedios" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="70" Text="{Binding Intermedios}"
                                 HorizontalContentAlignment="Center"/>
                        <StackPanel Grid.Column="2" Spacing="2" Margin="6,0,0,0">
                            <Button Content="▲" Width="34" Height="24" Padding="0"
                                    Command="{Binding IncrementarIntermediosCommand}"/>
                            <Button Content="▼" Width="34" Height="24" Padding="0"
                                    Command="{Binding DecrementarIntermediosCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="35,8,35,0">
                        <TextBlock Grid.Column="0" Text="Difíciles" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="70" Text="{Binding Dificiles}"
                                 HorizontalContentAlignment="Center"/>
                        <StackPanel Grid.Column="2" Spacing="2" Margin="6,0,0,0">
                            <Button Content="▲" Width="34" Height="24" Padding="0"
                                    Command="{Binding IncrementarDificilesCommand}"/>
                            <Button Content="▼" Width="34" Height="24" Padding="0"
                                    Command="{Binding DecrementarDificilesCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#e0e0e0" Margin="35,18,35,16"/>

                    <TextBlock Text="Personalizar Documento" FontSize="17" FontWeight="Bold"
                               Margin="35,0,35,14"/>

                    <StackPanel Margin="35,0" Spacing="4">
                        <TextBlock Text="Título:" FontSize="13"/>
                         <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ej: Examen de Matemáticas"/>
                        <TextBlock Text="Autor:" FontSize="13" Margin="0,8,0,0"/>
                         <TextBox Text="{Binding Autor, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ej: Nombre del profesor"/>
                        <TextBlock Text="Etiqueta de las imágenes:" FontSize="13" Margin="0,8,0,0"/>
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Etiquetas}"
                                   SelectedItem="{Binding Etiqueta, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Border Height="1" Background="#e0e0e0" Margin="35,14,35,12"/>

                    <TextBlock Text="Espacio en blanco entre ejercicios:" FontSize="13"
                               Margin="35,0,35,6"/>
                    <StackPanel Orientation="Horizontal" Margin="35,0" Spacing="12">
                        <CheckBox Content="Agregar espacio" IsChecked="{Binding AgregarEspacio}"
                                  VerticalAlignment="Center"/>
                         <TextBox Width="80" Text="{Binding EspacioTexto, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"
                                 IsEnabled="{Binding AgregarEspacio}"/>
                         <TextBlock Text="cm" VerticalAlignment="Center" FontSize="12"/>
                     </StackPanel>

                     <Border Height="1" Background="#e0e0e0" Margin="35,14,35,12"/>
                     <TextBlock Text="Tamaño de las imágenes:" FontSize="13" Margin="35,0,35,6"/>
                     <StackPanel Orientation="Horizontal" Margin="35,0" Spacing="12">
                         <CheckBox Content="Todas del mismo tamaño" IsChecked="{Binding ImagenesMismoTamano}"
                                   VerticalAlignment="Center"/>
                         <TextBox Width="80" Text="{Binding TamanoImagenTexto, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalContentAlignment="Center" IsEnabled="{Binding ImagenesMismoTamano}"/>
                         <TextBlock Text="cm alto" VerticalAlignment="Center" FontSize="12"/>
                     </StackPanel>

                    <TextBlock Text="{Binding TotalTexto}" FontSize="15" FontWeight="Bold"
                               Margin="35,24,35,6"/>

                    <Button Classes="action-button" Content="🎲 Generar PDF Aleatorio" Height="50" CornerRadius="10"
                            FontSize="15" FontWeight="Bold" Margin="35,10,35,30"
                            Background="#10b981" Foreground="White"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding GenerarCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#dcecf5" CornerRadius="12" Padding="18">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="4,0,4,12">
                    <TextBlock Text="Vista previa del documento" FontSize="18" FontWeight="Bold" Foreground="#0c4a6e"/>
                    <TextBlock Text="{Binding TextoVistaPrevia}" FontSize="12" Foreground="#52758a" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding Autor, StringFormat='Por: {0}'}" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="White" Padding="14" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding VistaPrevia}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Margin="5" Padding="8" Background="#ffffff"
                                                BorderBrush="#d9e6ed" BorderThickness="1" CornerRadius="5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Etiqueta}" FontSize="10" FontWeight="Bold"
                                                           Foreground="#0c4a6e" Margin="0,0,0,5"/>
                                                <Border Background="#f7fafc" Height="{Binding AltoImagen}">
                                                    <Image Source="{Binding Imagen}" Stretch="Uniform"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="La vista previa muestra una selección representativa del banco."
                                       FontSize="11" Foreground="#78909c" TextWrapping="Wrap" HorizontalAlignment="Center"
                                       Margin="8,14,8,0" IsVisible="{Binding HayVistaPrevia}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
